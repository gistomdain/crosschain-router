# Server-side provider credentials. Never expose these with NEXT_PUBLIC_ prefixes.
LIFI_API_KEY=
RELAY_API_KEY=
ACROSS_API_KEY=
ACROSS_INTEGRATOR_ID=
DEBRIDGE_API_KEY=

# Optional Jupiter API credential for Solana routing.
JUPITER_API_KEY=

# Server-side RPC endpoints used for source transaction confirmation.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=
\n# Solana RPC used server-side for transaction confirmation.\nSOLANA_RPC_URL=\n\n# Optional browser RPC for Solana Wallet Standard/Kit. Use a production endpoint in deployment.\nNEXT_PUBLIC_SOLANA_RPC_URL=\n